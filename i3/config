# i3 config file (converted from Sway)
# This file has been generated from your Sway config

# Font for window titles
font pango:ProggyClean.pcf 11

# Use Super key as modifier
set $mod Mod4

# Set GTK cursor theme
exec --no-startup-id gsettings set org.gnome.desktop.interface cursor-theme 'Hackneyed'
exec --no-startup-id gsettings set org.gnome.desktop.interface cursor-size 24
exec --no-startup-id xrdb ~/.Xresources

# Startup applications
exec --no-startup-id dbus-update-activation-environment DISPLAY I3SOCK

# Note: swww is Wayland-only, use feh for wallpaper instead
exec --no-startup-id feh --bg-tile ~/wall_secondary.png

# Audio services (converted from your start-audio.sh approach)
exec gentoo-pipewire-launcher &

# Other services (X11 equivalents)
#exec --no-startup-id alacritty --class=alacritty-daemon &
exec --no-startup-id dunst &

# Picom compositor
#exec --no-startup-id picom --backend glx -b

# Mouse cursor (X11 equivalent)
exec --no-startup-id xsetroot -cursor_name Hackneyed

# Cursor Speed
exec --no-startup-id xinput --set-prop 13 "libinput Accel Profile Enabled" 0, 1
exec --no-startup-id xinput --set-prop 13 "libinput Accel Speed" -0.20

exec --no-startup-id xrandr --output DP-4 --mode 1920x1080 --rate 239.76 --primary --pos 0x0 --output DP-2 --mode 1920x1080 --rate 60 --pos 1920x0

# Keybindings
# Screenshot (using maim + xclip instead of grim + wl-copy)
bindsym $mod+Shift+s exec --no-startup-id maim -s | xclip -selection clipboard -t image/png

# Window management
bindsym $mod+Shift+f floating toggle
bindsym $mod+r exec --no-startup-id rofi -show drun
bindsym $mod+q exec --no-startup-id st
bindsym $mod+c kill
bindsym $mod+Shift+c reload
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+r restart
bindsym $mod+m exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3?' -B 'Yes, exit i3' 'i3-msg exit'"

# Window movement
bindsym $mod+Right move right
bindsym $mod+Left move left

# Reboot to Windows (keeping your dual boot shortcut)
#bindsym $mod+p exec --no-startup-id "sudo bootctl set-oneshot auto-windows && sudo reboot"

# Resize shortcuts (converted from your Sway config)
bindsym $mod+Up resize grow width 1 px or 1 ppt
bindsym $mod+Down resize shrink width 1 px or 1 ppt

# Window borders and gaps
# i3-gaps syntax for gaps
gaps inner 0
gaps outer 0
hide_edge_borders both

# Split orientation
bindsym $mod+h split h
bindsym $mod+v split v

# Floating window modifier
floating_modifier $mod

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move containers to workspaces
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

# Multi-monitor workspace assignment
# Note: You'll need to adjust output names with `xrandr` command
workspace 1 output DP-4
workspace 3 output DP-4
workspace 5 output DP-4
workspace 7 output DP-4
workspace 9 output DP-4

workspace 2 output DP-2
workspace 4 output DP-2
workspace 6 output DP-2
workspace 8 output DP-2
workspace 10 output DP-2

# Move container to next monitor (X11 equivalent)
bindsym $mod+z move container to output left

# Window-specific rules
# Gaming window rules (Steam games)
for_window [class="steam_app_.*"] border none, fullscreen enable
for_window [class="Steam"] floating enable
for_window [title="Steam - News"] floating enable, resize set 800 600

# Color scheme (matching your Sway theme)
# class                 border  backgr. text    indicator child_border
client.focused          #202020 #202020 #ffffff #202020   #202020
client.focused_inactive #181818 #181818 #aaaaaa #181818   #181818
client.unfocused        #181818 #181818 #bbbbbb #181818   #181818
client.urgent           #ff5555 #ff5555 #ffffff #ff5555   #ff5555
client.placeholder      #000000 #000000 #ffffff #000000   #000000
client.background       #000000

# Status bar (using i3status instead of waybar)
bar {
    status_command i3blocks
    position top
    colors {
        background #181818
        statusline #ffffff
        separator  #666666
        focused_workspace  #202020 #202020 #ffffff
        active_workspace   #333333 #333333 #ffffff
        inactive_workspace #181818 #181818 #bbbbbb
        urgent_workspace   #ff5555 #ff5555 #ffffff
    }
}
